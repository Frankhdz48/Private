// Volume Profile System — POC Bounce / Value Area Reversal / Breakout
// Versión para BACKTEST en TradingView del EA VolumeProfileEA.mq5 (mismas reglas).
// - Calcula el Volume Profile de la sesión anterior (Row Size 60, Value Area 70 %)
//   con velas de menor temporalidad, lo dibuja y extiende POC/VAH/VAL al día actual.
// - El filtro de noticias NO existe aquí (TradingView no da el calendario a Pine).
//@version=5
strategy("VP System - POC / Reversal / Breakout", shorttitle="VP System", overlay=true, initial_capital=50, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.18, margin_long=0.1, margin_short=0.1, pyramiding=0, max_boxes_count=500, max_lines_count=500, max_labels_count=100, calc_on_every_tick=false, process_orders_on_close=false)

// ───────────────────────── ENTRADAS ─────────────────────────
gS = "Estrategias"
usePOC = input.bool(true, "#1 POC Bounce", group=gS)
useRev = input.bool(true, "#2 Value Area Reversal", group=gS)
useBO  = input.bool(true, "#3 Breakout", group=gS)

gP = "Volume Profile (configuración de la guía)"
profTF   = input.timeframe("5", "Velas para el perfil (MENOR que el gráfico)", group=gP)
rows     = input.int(60, "Row Size", minval=10, maxval=200, group=gP)
vaPct    = input.float(70.0, "Value Area Volume %", minval=1, maxval=99, group=gP)
minBars  = input.int(20, "Mínimo de velas para sesión válida", group=gP)
showProf = input.bool(true, "Dibujar histograma", group=gP)
histW    = input.float(35.0, "Ancho del histograma (% de la sesión)", group=gP)
cVA      = input.color(color.new(#2878AA, 40), "Filas dentro del VA", group=gP)
cOut     = input.color(color.new(#55555F, 50), "Filas fuera del VA", group=gP)
cPOC     = input.color(color.red, "POC", group=gP)
cEdge    = input.color(color.white, "VAH / VAL", group=gP)

gE = "Entradas"
atrLen   = input.int(14, "Periodo ATR", group=gE)
slBufATR = input.float(0.20, "Colchón del SL (x ATR)", group=gE)
maxSLATR = input.float(3.0, "Ignorar señales con SL mayor a X ATR", group=gE)

g1 = "#1 POC Bounce"
pocTouch  = input.float(0.25, "Tolerancia de toque al POC (x ATR)", group=g1)
pocPierce = input.float(0.50, "Máximo que puede perforar el POC (x ATR)", group=g1)
pinOK     = input.bool(true, "Aceptar pin bar además de envolvente", group=g1)
rrPOC     = input.float(2.0, "R:R", group=g1)

g2 = "#2 Value Area Reversal"
revCloseOut = input.bool(true, "Exigir una vela CERRADA fuera del VA", group=g2)
revMaxSide  = input.int(1, "Máx. por lado del VA por sesión (0 = sin límite)", group=g2)
rrRev       = input.float(2.0, "R:R", group=g2)

g3 = "#3 Breakout"
pbMode    = input.string("Zona VA", "Qué cuenta como pullback", options=["Zona VA", "Impulso", "Cualquiera"], group=g3)
pbATR     = input.float(0.50, "Zona VA: distancia al VAH/VAL (x ATR)", group=g3)
retrPct   = input.float(38.2, "Impulso: % mínimo de retroceso", group=g3)
minImpATR = input.float(1.0, "Impulso: tamaño mínimo de la ruptura (x ATR)", group=g3)
maxDepth  = input.float(30.0, "% máximo del VA que puede volver a entrar", group=g3)
openOut   = input.string("Exigir retest", "Si la sesión abre fuera del VA", options=["Ignorar", "Exigir retest", "Normal"], group=g3)
rrBO      = input.float(2.0, "R:R", group=g3)

gT = "Día de tendencia"
useTrend   = input.bool(true, "Detectar día de tendencia", group=gT)
trDist     = input.float(2.0, "Señal 1: precio a más de X ATR fuera del VA", group=gT)
adxLen     = input.int(14, "Señal 2: periodo ADX", group=gT)
adxMin     = input.float(25.0, "Señal 2: ADX mínimo (con DI a favor)", group=gT)
narrowVA   = input.float(0.5, "Señal 3: VA de ayer < X * ATR diario", group=gT)
trMinScore = input.int(2, "Señales necesarias (de 3)", minval=1, maxval=3, group=gT)
trBlock    = input.bool(true, "En tendencia: bloquear entradas en contra", group=gT)
trRunner   = input.bool(true, "En tendencia: entradas a favor sin TP (trailing)", group=gT)

gR = "Gestión de riesgo"
riskPct    = input.float(1.0, "Riesgo por operación (% del balance)", group=gR)
maxRiskMin = input.float(100.0, "Usar tamaño mínimo si arriesga <= X% (100 = siempre)", group=gR)
minQty     = input.float(1.0, "Tamaño mínimo en onzas (XM: 0.01 lote = 1 oz)", group=gR)
qtyStep    = input.float(1.0, "Incremento de tamaño en onzas", group=gR)
maxTrades  = input.int(3, "Máx. operaciones por sesión", group=gR)
maxDayLoss = input.float(3.0, "Pérdida máxima diaria (%)", group=gR)
maxConsec  = input.int(2, "Pérdidas seguidas para parar la sesión (0 = off)", group=gR)
useBE      = input.bool(true, "Mover SL a breakeven", group=gR)
beR        = input.float(1.0, "Breakeven al avanzar X R", group=gR)

gPa = "Cierre parcial"
usePartial = input.bool(true, "Cierre parcial", group=gPa)
partR      = input.float(2.0, "Cerrar parcial al llegar a X R", group=gPa)
partPct    = input.float(50.0, "% de la posición a cerrar", group=gPa)
runnerR    = input.float(0.0, "TP del resto en R (0 = sin TP, lo cierra el trailing)", group=gPa)

gTr = "Trailing stop"
trailMode = input.string("ATR", "Tipo de trailing", options=["Off", "ATR", "Swing", "Escalonado"], group=gTr)
trStartR  = input.float(1.0, "Activar al avanzar X R", group=gTr)
trATRm    = input.float(1.5, "ATR: distancia del stop (x ATR)", group=gTr)
trSwing   = input.int(3, "Swing: velas a mirar", group=gTr)
trStepR   = input.float(1.0, "Escalonado: cada X R sube el stop X R", group=gTr)
noTP      = input.bool(false, "Sin Take Profit en TODAS las operaciones", group=gTr)

// ───────────────────────── INDICADORES ─────────────────────────
atrV = ta.atr(atrLen)
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)
atrD = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead=barmerge.lookahead_on)
swingLo = ta.lowest(low, trSwing)
swingHi = ta.highest(high, trSwing)
trailOn = trailMode != "Off"

// Velas de menor temporalidad dentro de cada vela del gráfico (para el perfil)
[ltH, ltL, ltV] = request.security_lower_tf(syminfo.tickerid, profTF, [high, low, volume])

// ───────────────────────── FUNCIONES ─────────────────────────
// Volume Profile: reparte el volumen de cada vela entre su high y su low en N filas,
// POC = fila con más volumen, VA = se expande desde el POC hasta juntar el %.
f_profile(float[] hs, float[] ls, float[] vs, int nRows, float pct) =>
    int n = array.size(hs)
    float hi = array.max(hs)
    float lo = array.min(ls)
    float[] vols = array.new_float(nRows, 0.0)
    float stp = (hi - lo) / nRows
    float total = 0.0
    if stp > 0
        for i = 0 to n - 1
            float v = array.get(vs, i)
            if v > 0
                int b0 = math.max(0, math.min(nRows - 1, math.floor((array.get(ls, i) - lo) / stp)))
                int b1 = math.max(0, math.min(nRows - 1, math.floor((array.get(hs, i) - lo) / stp)))
                float share = v / (b1 - b0 + 1)
                for b = b0 to b1
                    array.set(vols, b, array.get(vols, b) + share)
                total += v
    int pocI = 0
    float mx = -1.0
    for b = 0 to nRows - 1
        if array.get(vols, b) > mx
            mx := array.get(vols, b)
            pocI := b
    int loI = pocI
    int hiI = pocI
    float acc = array.get(vols, pocI)
    float target = total * pct / 100.0
    while acc < target and (loI > 0 or hiI < nRows - 1)
        float up = hiI < nRows - 1 ? array.get(vols, hiI + 1) : -1.0
        float dn = loI > 0 ? array.get(vols, loI - 1) : -1.0
        if up >= dn
            hiI += 1
            acc += up
        else
            loI -= 1
            acc += dn
    [lo, stp, pocI, loI, hiI, vols, total]

f_better(int dir, float a, float b) =>
    dir > 0 ? math.max(a, b) : math.min(a, b)

f_bullPin() =>
    float rng = high - low
    float body = math.abs(close - open)
    float lw = math.min(open, close) - low
    rng > 0 and lw >= 2 * body and math.min(open, close) >= low + rng * 0.6

f_bearPin() =>
    float rng = high - low
    float body = math.abs(close - open)
    float uw = high - math.max(open, close)
    rng > 0 and uw >= 2 * body and math.max(open, close) <= high - rng * 0.6

// Tamaño por % de riesgo; si no alcanza para el mínimo, usa el mínimo si arriesga <= maxRiskMin
f_qty(float risk) =>
    float bal = strategy.initial_capital + strategy.netprofit
    float lossPer = risk * syminfo.pointvalue
    float q = math.floor(bal * riskPct / 100 / lossPer / qtyStep) * qtyStep
    if q < minQty
        float pct = lossPer * minQty / bal * 100
        q := pct <= maxRiskMin ? minQty : 0.0
    q

f_canSplit(float q) =>
    float part = math.floor(q * partPct / 100 / qtyStep) * qtyStep
    part >= minQty and q - part >= minQty

// ───────────────────────── ESTADO ─────────────────────────
var float[] sH = array.new_float()
var float[] sL = array.new_float()
var float[] sV = array.new_float()

var bool  pValid = false
var float pPOC = na
var float pVAH = na
var float pVAL = na
var float pClose = na
var int   sessStart = na
var line  lPOC = na
var line  lVAH = na
var line  lVAL = na

var int   boBullStage = 0
var float boBullExt = na
var float boBullPb = na
var bool  boBullRetest = false
var int   boBearStage = 0
var float boBearExt = na
var float boBearPb = na
var bool  boBearRetest = false

var bool  revAArmed = false
var float revAExt = na
var int   revACount = 0
var bool  revBArmed = false
var float revBExt = na
var int   revBCount = 0

var bool  pocDone = false
var int   trendDir = 0
var int   sessEntries = 0
var int   consec = 0
var int   seenClosed = 0
var float sessNetStart = 0.0

var bool   posPending = false
var bool   posOpen = false
var int    posEntryBar = na
var string posTag = ""
var int    posDir = 0
var float  posR = na
var float  posStop = na
var float  posTP = na
var float  posTP1 = na
var bool   posPartial = false
var float  posQty = 0.0
var float  posBest = na

// ───────────────────── NUEVA SESIÓN: PERFIL DE AYER ─────────────────────
newSession = timeframe.change("D")
if newSession
    pValid := false
    if array.size(sH) >= minBars and not na(sessStart)
        [lo, stp, pocI, loI, hiI, vols, tot] = f_profile(sH, sL, sV, rows, vaPct)
        if stp > 0 and tot > 0
            pValid := true
            pPOC := lo + (pocI + 0.5) * stp
            pVAH := lo + (hiI + 1) * stp
            pVAL := lo + loI * stp
            pClose := close[1]
            if showProf
                float mxv = array.get(vols, pocI)
                int span = bar_index - sessStart
                for b = 0 to rows - 1
                    float v = array.get(vols, b)
                    if v > 0
                        int w = math.max(1, math.round(span * histW / 100 * v / mxv))
                        color bc = b == pocI ? cPOC : (b >= loI and b <= hiI ? cVA : cOut)
                        box.new(sessStart, lo + (b + 1) * stp, sessStart + w, lo + b * stp, border_color=color.new(bc, 100), bgcolor=bc)
            lPOC := line.new(sessStart, pPOC, bar_index, pPOC, color=cPOC, width=2)
            lVAH := line.new(sessStart, pVAH, bar_index, pVAH, color=cEdge)
            lVAL := line.new(sessStart, pVAL, bar_index, pVAL, color=cEdge)
    array.clear(sH)
    array.clear(sL)
    array.clear(sV)
    sessStart := bar_index
    boBullStage := 0
    boBearStage := 0
    boBullRetest := false
    boBearRetest := false
    revAArmed := false
    revBArmed := false
    revACount := 0
    revBCount := 0
    pocDone := false
    trendDir := 0
    sessEntries := 0
    consec := 0
    sessNetStart := strategy.netprofit

// Acumular datos de la sesión actual para el perfil de mañana
if array.size(ltH) > 0
    for i = 0 to array.size(ltH) - 1
        array.push(sH, array.get(ltH, i))
        array.push(sL, array.get(ltL, i))
        float vv = array.get(ltV, i)
        array.push(sV, na(vv) ? 0.0 : vv)
else
    array.push(sH, high)
    array.push(sL, low)
    array.push(sV, na(volume) ? 0.0 : volume)

// Extender POC/VAH/VAL por la sesión actual
if pValid and not na(lPOC)
    line.set_x2(lPOC, bar_index)
    line.set_x2(lVAH, bar_index)
    line.set_x2(lVAL, bar_index)

// ───────────────────── ESTADÍSTICAS DE LA SESIÓN ─────────────────────
while seenClosed < strategy.closedtrades
    float pnl = strategy.closedtrades.profit(seenClosed)
    float mv = (strategy.closedtrades.exit_price(seenClosed) - strategy.closedtrades.entry_price(seenClosed)) * math.sign(strategy.closedtrades.size(seenClosed))
    if mv < -0.1 * nz(atrV)
        consec += 1
    else if pnl > 0
        consec := 0
    seenClosed += 1

// ───────────────────── ESTADO DE LA POSICIÓN ─────────────────────
if posPending and strategy.position_size != 0
    posPending := false
    posOpen := true
    posBest := strategy.position_avg_price
if posPending and strategy.position_size == 0 and bar_index > posEntryBar
    posPending := false
if posOpen and strategy.position_size == 0
    posOpen := false
    posPartial := false

// Cierre parcial ejecutado -> el resto ya no puede perder
if posOpen and posPartial and math.abs(strategy.position_size) < posQty - 1e-9
    posPartial := false
    posStop := f_better(posDir, posStop, strategy.position_avg_price)

// Breakeven + trailing (se aplica desde la vela siguiente)
if posOpen
    float ep = strategy.position_avg_price
    posBest := posDir > 0 ? math.max(posBest, high) : math.min(posBest, low)
    float prof = posDir > 0 ? posBest - ep : ep - posBest
    float ns = posStop
    if useBE and prof >= beR * posR
        ns := f_better(posDir, ns, ep)
    if trailOn and prof >= trStartR * posR
        float cand = na
        if trailMode == "ATR"
            cand := posDir > 0 ? posBest - trATRm * atrV : posBest + trATRm * atrV
        else if trailMode == "Swing"
            cand := posDir > 0 ? swingLo - slBufATR * atrV : swingHi + slBufATR * atrV
        else if trailMode == "Escalonado"
            int k = math.floor(prof / (trStepR * posR)) - 1
            if k >= 0
                cand := posDir > 0 ? ep + k * trStepR * posR : ep - k * trStepR * posR
        if not na(cand)
            ns := f_better(posDir, ns, cand)
    posStop := ns

// ───────────────────── DÍA DE TENDENCIA ─────────────────────
if useTrend and pValid and not na(atrV)
    int side = close > pVAH ? 1 : close < pVAL ? -1 : 0
    if side == 0
        trendDir := 0
    else if trendDir != side
        float dist = side > 0 ? close - pVAH : pVAL - close
        int score = 0
        if dist >= trDist * atrV
            score += 1
        if adxV >= adxMin and ((side > 0 and diP > diM) or (side < 0 and diM > diP))
            score += 1
        if atrD > 0 and (pVAH - pVAL) <= narrowVA * atrD
            score += 1
        if score >= trMinScore
            trendDir := side

// ───────────────────── SEÑALES ─────────────────────
float bal0  = strategy.initial_capital + sessNetStart
float dayPL = strategy.netprofit - sessNetStart
bool canTrade = pValid and not na(atrV) and not posPending and not posOpen and sessEntries < maxTrades and (maxConsec <= 0 or consec < maxConsec) and dayPL > -bal0 * maxDayLoss / 100

int    sigDir = 0
float  sigSL = na
float  sigRR = na
string sigTag = ""
int    sigSrc = 0
float  buf = slBufATR * nz(atrV)

// #2 Value Area Reversal — ayer cerró DENTRO del VA
if useRev and pValid and pClose <= pVAH and pClose >= pVAL
    bool inside = close < pVAH and close > pVAL
    bool aOK = revMaxSide <= 0 or revACount < revMaxSide
    bool bOK = revMaxSide <= 0 or revBCount < revMaxSide
    // Por arriba del VAH -> venta
    if not revAArmed
        if high > pVAH
            if close > pVAH
                revAArmed := true
                revAExt := high
            else if not revCloseOut and inside and canTrade and aOK and sigDir == 0
                sigDir := -1
                sigSL := high + buf
                sigRR := rrRev
                sigTag := "REV"
                sigSrc := 2
    else
        revAExt := math.max(revAExt, high)
        if inside
            revAArmed := false
            if canTrade and aOK and sigDir == 0
                sigDir := -1
                sigSL := revAExt + buf
                sigRR := rrRev
                sigTag := "REV"
                sigSrc := 2
        else if close < pVAL
            revAArmed := false
    // Por debajo del VAL -> compra
    if not revBArmed
        if low < pVAL
            if close < pVAL
                revBArmed := true
                revBExt := low
            else if not revCloseOut and inside and canTrade and bOK and sigDir == 0
                sigDir := 1
                sigSL := low - buf
                sigRR := rrRev
                sigTag := "REV"
                sigSrc := 3
    else
        revBExt := math.min(revBExt, low)
        if inside
            revBArmed := false
            if canTrade and bOK and sigDir == 0
                sigDir := 1
                sigSL := revBExt - buf
                sigRR := rrRev
                sigTag := "REV"
                sigSrc := 3
        else if close > pVAH
            revBArmed := false

// #3 Breakout — ruptura, pullback, Break of Structure
if useBO and pValid and not na(atrV)
    float mxD = (pVAH - pVAL) * maxDepth / 100
    float zone = pbATR * atrV
    // Alcista
    if boBullStage == 0
        if close > pVAH
            bool crossed = close[1] <= pVAH
            if crossed or openOut != "Ignorar"
                boBullStage := 1
                boBullExt := high
                boBullRetest := not crossed and openOut == "Exigir retest"
    else if boBullStage == 1
        if close < pVAH - mxD
            boBullStage := 0
        else
            bool inZone = low <= pVAH + zone
            float imp = boBullExt - pVAH
            bool retr = imp >= minImpATR * atrV and (boBullExt - low) >= imp * retrPct / 100
            bool pb = boBullRetest ? inZone : pbMode == "Zona VA" ? inZone : pbMode == "Impulso" ? retr : (inZone or retr)
            if pb
                boBullStage := 2
                boBullPb := low
            else
                boBullExt := math.max(boBullExt, high)
    else if boBullStage == 2
        boBullPb := math.min(boBullPb, low)
        if close < pVAH - mxD
            boBullStage := 0
        else if close > boBullExt
            boBullStage := 3
            if canTrade and sigDir == 0
                sigDir := 1
                sigSL := boBullPb - buf
                sigRR := rrBO
                sigTag := "BO"
                sigSrc := 4
    // Bajista
    if boBearStage == 0
        if close < pVAL
            bool crossedB = close[1] >= pVAL
            if crossedB or openOut != "Ignorar"
                boBearStage := 1
                boBearExt := low
                boBearRetest := not crossedB and openOut == "Exigir retest"
    else if boBearStage == 1
        if close > pVAL + mxD
            boBearStage := 0
        else
            bool inZoneB = high >= pVAL - zone
            float impB = pVAL - boBearExt
            bool retrB = impB >= minImpATR * atrV and (high - boBearExt) >= impB * retrPct / 100
            bool pbB = boBearRetest ? inZoneB : pbMode == "Zona VA" ? inZoneB : pbMode == "Impulso" ? retrB : (inZoneB or retrB)
            if pbB
                boBearStage := 2
                boBearPb := high
            else
                boBearExt := math.min(boBearExt, low)
    else if boBearStage == 2
        boBearPb := math.max(boBearPb, high)
        if close > pVAL + mxD
            boBearStage := 0
        else if close < boBearExt
            boBearStage := 3
            if canTrade and sigDir == 0
                sigDir := -1
                sigSL := boBearPb + buf
                sigRR := rrBO
                sigTag := "BO"
                sigSrc := 4

// #1 POC Bounce — ayer cerró FUERA del VA
if usePOC and pValid and not pocDone and not newSession and not na(atrV)
    float tol = pocTouch * atrV
    float prc = pocPierce * atrV
    if pClose > pVAH
        float mn = math.min(low, low[1])
        bool touched = mn <= pPOC + tol and mn >= pPOC - prc
        bool eng = close[1] < open[1] and close > open and close >= open[1] and open <= close[1]
        bool pin = pinOK and f_bullPin()
        if touched and (eng or pin) and close > pPOC
            pocDone := true
            if canTrade and sigDir == 0
                sigDir := 1
                sigSL := math.min(mn, pPOC) - buf
                sigRR := rrPOC
                sigTag := "POC"
                sigSrc := 1
    else if pClose < pVAL
        float mx2 = math.max(high, high[1])
        bool touchedS = mx2 >= pPOC - tol and mx2 <= pPOC + prc
        bool engS = close[1] > open[1] and close < open and close <= open[1] and open >= close[1]
        bool pinS = pinOK and f_bearPin()
        if touchedS and (engS or pinS) and close < pPOC
            pocDone := true
            if canTrade and sigDir == 0
                sigDir := -1
                sigSL := math.max(mx2, pPOC) + buf
                sigRR := rrPOC
                sigTag := "POC"
                sigSrc := 1

// ───────────────────── ENTRADA ─────────────────────
if sigDir != 0
    bool blocked = useTrend and trBlock and trendDir != 0 and sigDir != trendDir
    float epx = close
    float risk = sigDir > 0 ? epx - sigSL : sigSL - epx
    float qty = 0.0
    if not blocked and risk > 0 and risk <= maxSLATR * atrV
        qty := f_qty(risk)
    if qty > 0
        bool partial = usePartial and f_canSplit(qty)
        bool runner = useTrend and trRunner and trailOn and trendDir == sigDir
        float tp = epx + sigDir * sigRR * risk
        float tp1 = na
        if partial
            tp1 := epx + sigDir * partR * risk
            float rr2 = runnerR > 0 ? runnerR : (trailOn ? na : 2 * partR)
            tp := na(rr2) ? na : epx + sigDir * rr2 * risk
        if (noTP and trailOn) or runner
            tp := na
        strategy.entry(sigTag, sigDir > 0 ? strategy.long : strategy.short, qty=qty, comment=sigTag + (runner ? " tendencia" : ""))
        posPending := true
        posEntryBar := bar_index
        posTag := sigTag
        posDir := sigDir
        posR := risk
        posStop := sigSL
        posTP := tp
        posTP1 := tp1
        posPartial := partial
        posQty := qty
        posBest := epx
        sessEntries += 1
        if sigSrc == 2
            revACount += 1
        if sigSrc == 3
            revBCount += 1

// ───────────────────── SALIDAS (SL / TP / parcial) ─────────────────────
if posPending or posOpen
    if posPartial
        strategy.exit("TP1", from_entry=posTag, qty_percent=partPct, stop=posStop, limit=posTP1, comment="Parcial")
    strategy.exit("Salida", from_entry=posTag, stop=posStop, limit=posTP, comment="Salida")

// ───────────────────── VISUAL ─────────────────────
plot(posPending or posOpen ? posStop : na, "Stop Loss", color=color.orange, style=plot.style_linebr, linewidth=2)
plot(posPending or posOpen ? posTP : na, "Take Profit", color=color.lime, style=plot.style_linebr)
bgcolor(trendDir > 0 ? color.new(color.green, 92) : trendDir < 0 ? color.new(color.red, 92) : na, title="Día de tendencia")

var table info = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 25), border_width=1)
if barstate.islast and pValid
    string st = pClose > pVAH ? "Fuera arriba -> POC Bounce" : pClose < pVAL ? "Fuera abajo -> POC Bounce" : "Dentro -> Reversal"
    table.cell(info, 0, 0, "VAH", text_color=color.white)
    table.cell(info, 1, 0, str.tostring(pVAH, format.mintick), text_color=color.white)
    table.cell(info, 0, 1, "POC", text_color=color.red)
    table.cell(info, 1, 1, str.tostring(pPOC, format.mintick), text_color=color.red)
    table.cell(info, 0, 2, "VAL", text_color=color.white)
    table.cell(info, 1, 2, str.tostring(pVAL, format.mintick), text_color=color.white)
    table.cell(info, 0, 3, "Ayer cerró", text_color=color.white)
    table.cell(info, 1, 3, st, text_color=color.yellow)
    table.cell(info, 0, 4, "Tendencia", text_color=color.white)
    table.cell(info, 1, 4, trendDir > 0 ? "Alcista" : trendDir < 0 ? "Bajista" : "No", text_color=color.white)
